{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "badcow/phrase-generator": "dev-master",
        "barryvdh/laravel-ide-helper": "^v3.5.5",
        "cweagans/composer-patches": "^1.7",
        "erusev/parsedown": "^1.7",
        "friendsofphp/php-cs-fixer": "^3.10",
        "gmostafa/php-graphql-oqm": "^1.4",
        "graham-campbell/gitlab": "^7.6",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.7",
        "larastan/larastan": "^v3.2.0",
        "laravel/framework": "v11.44.2",
        "laravel/horizon": "^5.8",
        "laravel/sanctum": "^v4.0.8",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4.6",
        "league/csv": "^9.7",
        "maatwebsite/excel": "^3.1",
        "php-flasher/flasher-laravel": "^1.15",
        "psr/http-factory": "^1.1",
        "sentry/sentry": "^4.10",
        "sentry/sentry-laravel": "^4.13",
        "spatie/laravel-ignition": "^2.9",
        "spatie/laravel-markdown": "^2.4",
        "spatie/shiki-php": "^1.3",
        "symfony/process": "^v7.2.4",
        "symfony/yaml": "^6.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "itsgoingd/clockwork": "^5.1",
        "laravel/dusk": "^v8.3.2",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^v8.6.1",
        "nunomaduro/termwind": "^v2.3.0",
        "pestphp/pest": "^v3.7.2",
        "pestphp/pest-plugin-laravel": "^v3.1.0",
        "phpstan/phpstan": "^2.1.3",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "files": ["app/helpers.php"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Domain\\": "domain/",
            "GraphQL\\SchemaObject\\": "GraphQL/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "m4tthumphrey/php-gitlab-api": {
                "Adds support for additional fork parameters, see: https://github.com/GitLabPHP/Client/pull/820": "./patches/php-gitlab-api-fork-params.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        }
    },
    "prefer-stable": true
}
